@model Quiz

@{
    ViewData["Title"] = "Запуск квиза";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-body text-center p-5">
                    <h2>Запуск квиза</h2>
                    <h4 class="mt-3">@Model.Title</h4>
                    <p class="text-muted">@Model.Description</p>
                    
                    <div class="mt-4 p-4 bg-light rounded">
                        <h5>Параметры квиза:</h5>
                        <ul class="list-unstyled">
                            <li><strong>Категория:</strong> @Model.Category</li>
                            <li><strong>Вопросов:</strong> @Model.Questions.Count</li>
                            <li><strong>Время на вопрос:</strong> @Model.TimeLimitPerQuestion сек.</li>
                        </ul>
                    </div>

                    <div class="mt-4">
                        <button id="startQuizBtn" class="btn btn-success btn-lg" onclick="startQuiz()">
                            ▶️ Начать квиз
                        </button>
                        <a href="/Quiz/MyQuizzes" class="btn btn-secondary btn-lg ms-2">
                            ← Назад
                        </a>
                    </div>

                    <div id="roomInfo" style="display: none;" class="mt-4">
                        <div class="alert alert-success">
                            <h5>Комната создана</h5>
                            <p>Код комнаты: <strong id="roomCodeDisplay" class="display-4"></strong></p>
                            <p>Подключитесь к квизу по ссылке:</p>
                            <div class="input-group mb-3">
                                <input type="text" id="joinLink" class="form-control" readonly />
                                <button class="btn btn-outline-primary" onclick="copyLink()">Копировать</button>
                            </div>
                            <a id="joinLinkBtn" href="#" class="btn btn-primary">🔗 Перейти в комнату</a>
                            <button id="beginQuizBtn" type="button" class="btn btn-success ms-2" style="display:none" onclick="beginQuiz()">▶️ Начать квиз для всех</button>
                            <div id="hostControls" class="mt-3" style="display:none">
                                <button id="nextQuestionBtn" type="button" class="btn btn-primary" onclick="advanceQuestion()">Следующий вопрос →</button>
                                <button id="endQuizBtn" type="button" class="btn btn-outline-danger ms-2" onclick="finishQuiz()">Завершить квиз</button>
                            </div>
                            <p id="hostStatus" class="mt-3 mb-0">После подключения участников нажмите кнопку, чтобы начать квиз.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function startQuiz() {
    const btn = document.getElementById('startQuizBtn');
    btn.disabled = true;
    btn.textContent = '⏳ Запуск...';

    const quizId = @Model.Id;
        
    fetch(`/Quiz/StartQuizSession?quizId=${quizId}`, {
    method: 'POST',
    headers: {
    'Content-Type': 'application/json'
    }
    })
    .then(response => {
    if (!response.ok) {
    throw new Error('Ошибка при запуске квиза');
    }
    return response.json();
    })
    .then(data => {
    document.getElementById('roomInfo').style.display = 'block';
    document.getElementById('roomCodeDisplay').textContent = data.roomCode;
    window.totalQuestions = data.totalQuestions;
    window.currentQuestionIndex = 0;
            
    const joinUrl = window.location.origin + '/Quiz/Join?roomCode=' + data.roomCode;
    document.getElementById('joinLink').value = joinUrl;
    document.getElementById('joinLinkBtn').href = joinUrl;
            
    btn.textContent = 'Комната создана';
    btn.className = 'btn btn-info btn-lg';
            
    setupQuizHub(data.sessionId, data.roomCode);
    })
    .catch(error => {
    console.error('Error:', error);
    alert('Ошибка при запуске квиза: ' + error.message);
    btn.disabled = false;
    btn.textContent = '▶️ Начать квиз';
    });
    }

    function setupQuizHub(sessionId, roomCode) {
    const connection = new signalR.HubConnectionBuilder()
    .withUrl("/quizHub")
    .build();

    connection.start()
    .then(() => {
    console.log('SignalR connected');
    return connection.invoke("JoinRoom", roomCode, "Организатор");
    })
    .then(() => {
    document.getElementById('beginQuizBtn').style.display = 'inline-block';
    })
    .catch(err => console.error(err));

    connection.on("UserJoined", function(userName) {
    console.log(`User ${userName} joined`);
    
    });

    connection.on("UpdateParticipants", function(participants) {
    console.log('Participants:', participants);
    });

    window.quizHub = connection;
    window.roomCode = roomCode;
    window.sessionId = sessionId;
    }

    async function beginQuiz() {
        const button = document.getElementById('beginQuizBtn');
        button.disabled = true;
        button.textContent = '⏳ Запуск...';
        try {
            const response = await fetch(`/Quiz/BeginQuizSession?sessionId=${window.sessionId}`, { method: 'POST' });
            const result = await response.json();
            if (!response.ok) throw new Error(result.error || 'Не удалось начать квиз');
            button.textContent = 'Квиз начался';
            button.style.display = 'none';
            document.getElementById('hostControls').style.display = 'block';
            document.getElementById('hostStatus').textContent = 'Квиз начался у всех участников комнаты.';
            if (window.totalQuestions <= 1) document.getElementById('nextQuestionBtn').disabled = true;
        } catch (error) {
            button.disabled = false;
            button.textContent = '▶️ Начать квиз для всех';
            alert(error.message);
        }
    }

    async function advanceQuestion() {
        const button = document.getElementById('nextQuestionBtn');
        button.disabled = true;
        try {
            const response = await fetch(`/Quiz/AdvanceQuizSession?sessionId=${window.sessionId}`, { method: 'POST' });
            const result = await response.json();
            if (!response.ok) throw new Error(result.error || 'Не удалось переключить вопрос.');
            window.currentQuestionIndex = result.questionIndex;
            document.getElementById('hostStatus').textContent = `Вопрос ${result.questionIndex + 1} из ${result.totalQuestions}`;
            if (window.currentQuestionIndex + 1 < window.totalQuestions) button.disabled = false;
        } catch (error) {
            button.disabled = false;
            alert(error.message);
        }
    }

    async function finishQuiz() {
        const button = document.getElementById('endQuizBtn');
        button.disabled = true;
        try {
            const response = await fetch(`/Quiz/EndQuizSession?sessionId=${window.sessionId}`, { method: 'POST' });
            if (!response.ok) {
                const result = await response.json();
                throw new Error(result.error || 'Не удалось завершить квиз.');
            }
            document.getElementById('hostControls').style.display = 'none';
            document.getElementById('hostStatus').textContent = 'Квиз завершён.';
        } catch (error) {
            button.disabled = false;
            alert(error.message);
        }
    }

    function copyLink() {
    const linkInput = document.getElementById('joinLink');
    linkInput.select();
    document.execCommand('copy');
    alert('Ссылка скопирована!');
    }

</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
