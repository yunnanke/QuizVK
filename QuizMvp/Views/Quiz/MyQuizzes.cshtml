@model List<Quiz>

@{
    ViewData["Title"] = "Мои квизы";
}

@section Styles {
    <link rel="stylesheet" href="~/css/quiz-workspace.css" asp-append-version="true" />
}

<div class="quiz-workspace catalog-page">
    <div class="row">
        <div class="col-12">
            <header class="workspace-hero catalog-hero">
                <div>
                    <div class="workspace-eyebrow"><span></span>ВАША КОЛЛЕКЦИЯ</div>
                    <h1>Мои квизы</h1>
                    <p>Все ваши викторины и инструменты для управления ими в одном месте.</p>
                </div>
                <a class="hero-action" href="/Quiz/Create"><span aria-hidden="true">+</span> Создать квиз</a>
            </header>
            
            @if (Model.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state-icon" aria-hidden="true">Q</div>
                    <h2>Здесь пока пусто</h2>
                    <p>Создайте свой первый квиз — он появится в этой коллекции.</p>
                    <a href="/Quiz/Create" class="hero-action">Создать первый квиз <span aria-hidden="true">→</span></a>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var quiz in Model)
                    {
                        var createdDate = quiz.CreatedAt.ToString("yyyy-MM-dd");
                        <div class="col-md-4 mb-4">
                            <div class="card quiz-tile h-100">
                                <div class="card-body">
                                    <div class="quiz-tile-meta">
                                        <span class="category-chip">@quiz.Category</span>
                                        <span class="question-count">@quiz.Questions.Count вопросов</span>
                                    </div>
                                    <h2 class="card-title">@quiz.Title</h2>
                                    <p class="card-text">@(string.IsNullOrWhiteSpace(quiz.Description) ? "Описание не добавлено." : quiz.Description)</p>
                                    <div class="quiz-actions">
                                        <a href="/Quiz/Play?quizId=@quiz.Id" class="quiz-action quiz-action-preview">Предпросмотр</a>
                                        <a href="/Quiz/StartQuiz?quizId=@quiz.Id" class="quiz-action quiz-action-launch">Запустить</a>
                                        <a href="/Quiz/Edit/@quiz.Id" class="quiz-action quiz-action-edit" aria-label="Редактировать квиз @quiz.Title">Изменить</a>
                                    </div>
                                </div>
                                <div class="card-footer quiz-tile-footer">
                                    <span>Создан</span>
                                    <time datetime="@createdDate">@quiz.CreatedAt.ToString("dd.MM.yyyy")</time>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
