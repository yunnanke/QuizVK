@{
    ViewData["Title"] = "Главная";
    var username = Context.Session.GetString("Username") ?? "Участник";
    var role = Context.Session.GetString("Role");
    var isOrganizer = role == "Organizer";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home-dashboard.css" asp-append-version="true" />
}

<div class="dashboard-shell">
    <header class="dashboard-hero">
        <div class="hero-copy">
            <div class="dashboard-eyebrow"><span class="eyebrow-dot"></span>ПРОСТРАНСТВО QUIZVK</div>
            <h1>Добро пожаловать,<br /><span>@username</span></h1>
            <p>@(isOrganizer ? "Создавайте квизы, управляйте играми и следите за результатами." : "Проверьте свои знания или присоединитесь к новой викторине.")</p>
            <div class="role-pill"><span class="role-indicator"></span>@(isOrganizer ? "Организатор" : "Участник")</div>
        </div>
        <div class="hero-art" aria-hidden="true">
            <div class="hero-orbit hero-orbit-one"></div>
            <div class="hero-orbit hero-orbit-two"></div>
            <div class="hero-tile hero-tile-main">Q</div>
            <div class="hero-tile hero-tile-small hero-tile-check">✓</div>
            <div class="hero-tile hero-tile-small hero-tile-spark">✦</div>
        </div>
    </header>

    @if (isOrganizer)
    {
        <section class="dashboard-section" aria-labelledby="organizer-actions-title">
            <div class="section-heading">
                <div>
                    <div class="section-kicker">ВАШИ ИНСТРУМЕНТЫ</div>
                    <h2 id="organizer-actions-title">Рабочая панель</h2>
                </div>
                <p>Всё необходимое для вашей следующей игры</p>
            </div>

            <div class="action-grid">
                <a class="action-card action-card-create" href="/Quiz/Create">
                    <span class="action-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
                    </span>
                    <span class="action-content">
                        <strong>Создать квиз</strong>
                        <span>Придумайте вопросы и запустите новую игру</span>
                    </span>
                    <span class="action-arrow" aria-hidden="true">→</span>
                </a>

                <a class="action-card action-card-manage" href="/Quiz/MyQuizzes">
                    <span class="action-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H20v15H5.5A1.5 1.5 0 0 0 4 20.5zM4 5.5v15M8 8h8M8 11h8M8 14h5" /></svg>
                    </span>
                    <span class="action-content">
                        <strong>Мои квизы</strong>
                        <span>Откройте, отредактируйте или проведите игру</span>
                    </span>
                    <span class="action-arrow" aria-hidden="true">→</span>
                </a>

                <a class="action-card action-card-stats" href="/Quiz/Statistics">
                    <span class="action-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M4 19V5M4 19h17M8 16v-4M13 16V8M18 16V5" /></svg>
                    </span>
                    <span class="action-content">
                        <strong>Статистика</strong>
                        <span>Посмотрите, как прошли ваши викторины</span>
                    </span>
                    <span class="action-arrow" aria-hidden="true">→</span>
                </a>
            </div>
        </section>
    }
    else
    {
        <section class="participant-grid" aria-label="Участие в квизах">
            <div class="join-panel">
                <div class="section-kicker">ГОТОВЫ ИГРАТЬ?</div>
                <h2>Присоединиться к квизу</h2>
                <p>Введите код комнаты, который сообщил организатор</p>
                <form action="/Quiz/Join" method="get" class="join-form">
                    <label class="visually-hidden" for="roomCode">Код комнаты</label>
                    <input id="roomCode" type="text" name="roomCode" placeholder="Например, A4K29B" maxlength="6" autocomplete="off" autocapitalize="characters" required />
                    <button type="submit">
                        Войти в комнату
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </button>
                </form>
                <div class="join-note"><span aria-hidden="true">i</span> Код состоит из 6 символов и действует для текущей игры.</div>
            </div>

            <aside class="participant-tip">
                <div class="tip-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M9 18h6M10 21h4M8.2 14.5a6 6 0 1 1 7.6 0c-.8.6-1.3 1.3-1.5 2.2h-4.6c-.2-.9-.7-1.6-1.5-2.2Z" /></svg>
                </div>
                <div class="section-kicker">БЫСТРЫЙ СТАРТ</div>
                <h3>Как начать игру</h3>
                <ol class="quick-steps">
                    <li><span>1</span>Получите код у организатора</li>
                    <li><span>2</span>Введите код в поле слева</li>
                    <li><span>3</span>Дождитесь начала квиза</li>
                </ol>
            </aside>
        </section>

        <section class="history-panel" aria-labelledby="history-title">
            <div class="section-heading history-heading">
                <div>
                    <div class="section-kicker">ВАШИ РЕЗУЛЬТАТЫ</div>
                    <h2 id="history-title">История участия</h2>
                </div>
                <button type="button" class="refresh-button" id="refreshHistory" aria-label="Обновить историю">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5M5.6 9A7 7 0 0 1 18 6l2 2M4 16l2 2a7 7 0 0 0 12.4-3" /></svg>
                    Обновить
                </button>
            </div>
            <div id="historyState" class="history-state" role="status" aria-live="polite">Загружаем историю…</div>
            <ul id="historyList" class="history-list" hidden></ul>
        </section>
    }
</div>

@section Scripts {
    @if (!isOrganizer)
    {
        <script>
            const historyState = document.getElementById('historyState');
            const historyList = document.getElementById('historyList');

            async function loadHistory() {
                historyState.textContent = 'Загружаем историю…';
                historyState.hidden = false;
                historyList.replaceChildren();
                historyList.hidden = true;

                try {
                    const response = await fetch('/Quiz/GetHistory');
                    if (!response.ok) throw new Error('Не удалось получить историю');

                    const items = await response.json();
                    if (items.length === 0) {
                        historyState.textContent = 'Пока здесь пусто. Пройдите свой первый квиз — результат появится здесь.';
                        return;
                    }

                    for (const item of items) {
                        const row = document.createElement('li');
                        row.className = 'history-item';

                        const title = document.createElement('span');
                        title.className = 'history-quiz-title';
                        title.textContent = item.quizTitle;

                        const result = document.createElement('span');
                        result.className = 'history-result';
                        result.textContent = `${item.score} баллов`;

                        row.append(title, result);
                        historyList.append(row);
                    }

                    historyState.textContent = '';
                    historyState.hidden = true;
                    historyList.hidden = false;
                } catch {
                    historyState.textContent = 'Не удалось загрузить историю. Попробуйте обновить.';
                }
            }

            document.getElementById('refreshHistory').addEventListener('click', loadHistory);
            loadHistory();
        </script>
    }
}
