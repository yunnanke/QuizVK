@{
    Layout = null;
    ViewData["Title"] = "Регистрация";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#242746" />
    <title>@ViewData["Title"] — QuizVK</title>
    <link rel="stylesheet" href="~/css/auth-pages.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <main class="auth-layout auth-layout-register">
        <section class="auth-intro" aria-labelledby="intro-title">
            <a class="auth-brand" href="/" aria-label="QuizVK — на главную">
                <span class="brand-mark" aria-hidden="true">Q</span>
                <span>QuizVK</span>
            </a>

            <div class="intro-copy">
                <div class="eyebrow"><span class="eyebrow-dot"></span>ВАША ИГРА НАЧИНАЕТСЯ ЗДЕСЬ</div>
                <h1 id="intro-title">Создавайте<br />свои <span>викторины</span></h1>
                <p>Один аккаунт — чтобы играть, делиться знаниями и собирать друзей за квизом.</p>
            </div>

            <div class="intro-art" aria-hidden="true">
                <div class="orbit orbit-one"></div>
                <div class="orbit orbit-two"></div>
                <div class="art-tile art-tile-main">Q</div>
                <div class="art-tile art-tile-check">✓</div>
                <div class="art-tile art-tile-spark">✦</div>
            </div>

            <div class="intro-foot"><span class="foot-dot"></span>Ваш следующий любимый квиз — впереди</div>
        </section>

        <section class="auth-content" aria-labelledby="form-title">
            <div class="auth-card auth-card-register">
                <div class="mobile-brand"><span class="brand-mark" aria-hidden="true">Q</span>QuizVK</div>
                <div class="form-heading">
                    <div class="form-kicker">НОВЫЙ УЧАСТНИК</div>
                    <h2 id="form-title">Создать аккаунт</h2>
                    <p>Заполните данные — и можно начинать</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="auth-alert" role="alert">@ViewBag.Error</div>
                }

                <form method="post" action="/Account/Register" class="auth-form">
                    <div class="field-group">
                        <label for="username">Имя пользователя</label>
                        <input id="username" type="text" name="username" value="@ViewBag.Username" autocomplete="username" placeholder="Как к вам обращаться" required />
                    </div>
                    <div class="field-group">
                        <label for="email">Электронная почта</label>
                        <input id="email" type="email" name="email" value="@ViewBag.Email" autocomplete="email" placeholder="name@example.com" required />
                    </div>
                    <div class="field-group">
                        <label for="password">Пароль</label>
                        <input id="password" type="password" name="password" autocomplete="new-password" placeholder="Придумайте пароль" aria-describedby="password-help" required />
                        <span class="field-hint" id="password-help">Не менее 8 символов, минимум одна буква любого алфавита и один специальный символ.</span>
                    </div>
                    <div class="field-group">
                        <label for="role">Я хочу</label>
                        <select id="role" name="role">
                            <option value="Participant" selected="@(ViewBag.Role != "Organizer")">Играть в квизы</option>
                            <option value="Organizer" selected="@(ViewBag.Role == "Organizer")">Создавать квизы</option>
                        </select>
                    </div>
                    <button class="auth-submit" type="submit">Зарегистрироваться <span aria-hidden="true">→</span></button>
                </form>

                <p class="auth-switch">Уже есть аккаунт? <a href="/Account/Login">Войти</a></p>
                <a class="back-link" href="/">← На главную</a>
            </div>
            <div class="auth-copyright">QuizVK <span>·</span> Пространство для ваших идей</div>
        </section>
    </main>
</body>
</html>
