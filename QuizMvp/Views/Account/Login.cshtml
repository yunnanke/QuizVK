@{
    Layout = null;
    ViewData["Title"] = "Вход";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#242746" />
    <title>@ViewData["Title"] — QuizVK</title>
    <link rel="stylesheet" href="~/css/auth-pages.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <main class="auth-layout">
        <section class="auth-intro" aria-labelledby="intro-title">
            <a class="auth-brand" href="/" aria-label="QuizVK — на главную">
                <span class="brand-mark" aria-hidden="true">Q</span>
                <span>QuizVK</span>
            </a>

            <div class="intro-copy">
                <div class="eyebrow"><span class="eyebrow-dot"></span>ПРОСТРАНСТВО QUIZVK</div>
                <h1 id="intro-title">Знания<br />становятся <span>игрой</span></h1>
                <p>Возвращайтесь к своим квизам, результатам и новым открытиям.</p>
            </div>

            <div class="intro-art" aria-hidden="true">
                <div class="orbit orbit-one"></div>
                <div class="orbit orbit-two"></div>
                <div class="art-tile art-tile-main">Q</div>
                <div class="art-tile art-tile-check">✓</div>
                <div class="art-tile art-tile-spark">✦</div>
            </div>

            <div class="intro-foot"><span class="foot-dot"></span>Викторины, которые объединяют</div>
        </section>

        <section class="auth-content" aria-labelledby="form-title">
            <div class="auth-card">
                <div class="mobile-brand"><span class="brand-mark" aria-hidden="true">Q</span>QuizVK</div>
                <div class="form-heading">
                    <div class="form-kicker">С ВОЗВРАЩЕНИЕМ</div>
                    <h2 id="form-title">Войти в аккаунт</h2>
                    <p>Введите данные, чтобы продолжить</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="auth-alert" role="alert">@ViewBag.Error</div>
                }

                <form method="post" action="/Account/Login" class="auth-form">
                    <div class="field-group">
                        <label for="username">Имя пользователя</label>
                        <input id="username" type="text" name="username" autocomplete="username" placeholder="Например, egor" required />
                    </div>
                    <div class="field-group">
                        <label for="password">Пароль</label>
                        <input id="password" type="password" name="password" autocomplete="current-password" placeholder="Введите пароль" required />
                    </div>
                    <button class="auth-submit" type="submit">Войти <span aria-hidden="true">→</span></button>
                </form>

                <p class="auth-switch">Нет аккаунта? <a href="/Account/Register">Зарегистрироваться</a></p>
                <a class="back-link" href="/">← На главную</a>
            </div>
            <div class="auth-copyright">QuizVK <span>·</span> Пространство для ваших идей</div>
        </section>
    </main>
</body>
</html>
